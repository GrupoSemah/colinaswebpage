---
---

<section class="py-16 bg-white">
  <div class="container mx-auto px-6">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-dark-gray mb-4">
          Nuestra Ubicación
        </h2>
        <p class="text-lg text-gray-accessible max-w-2xl mx-auto">
          Nos encontramos en Hato Montaña, Arraiján, Panamá Oeste. 
          Un lugar tranquilo y accesible para brindar el mejor servicio a las familias.
        </p>
      </div>

      <!-- Map Container -->
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
        <div class="relative w-full h-[450px] lg:h-[600px]">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d8950.559473891368!2d-79.7422057!3d8.923138!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8faca27869454ba9%3A0xe0109837e6bc43a0!2sCementerio%20Colinas%20de%20la%20Paz!5e1!3m2!1ses-419!2spa!4v1759356019792!5m2!1ses-419!2spa"
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación de Colinas de la Paz">
          </iframe>
        </div>
        
        <!-- Map Footer -->
        <div class="p-6 lg:p-8">
          <div class="flex flex-col md:flex-row items-center justify-between gap-4">

            
            <div>
              <a 
                href="https://maps.app.goo.gl/G8qf7qguvxSZpqmN7" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-2 bg-green-primary text-white px-6 py-3 rounded-full hover:bg-green-dark transition-all duration-300 font-medium text-sm"
                aria-label="Ver ubicación en Google Maps"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                Ver en Google Maps
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
