---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/obituarios/Hero.astro';
import SearchBar from '../components/obituarios/SearchBar.astro';
import ObituaryGrid from '../components/obituarios/ObituaryGrid';
---

<Layout 
  title="Obituario | Colinas de la Paz"
  description="Consulta los obituarios actualizados para honrar la memoria de tus seres queridos y acompañar a las familias en momentos de reflexión y respeto."
  keywords={["obituarios"]}
  canonical="https://www.colinasdelapaz.com/obituarios"
>
  <Hero />
  <SearchBar />
  <ObituaryGrid client:load />
</Layout>
