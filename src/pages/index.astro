---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Home/hero/Hero.astro';
import Description from '../components/Home/description/Description.astro';
import Services from '../components/Home/services/Services.astro';
import CTA from '../components/Home/cta/CTA.astro';
---

<Layout 
  title="Parque Cementerio | Colinas de la Paz | Panamá Oeste"
  description="Cementerio y funeraria privada en Arraiján Chorrera con servicios funerarios, cremaciones y planes exequiales que te acompañan en todo el proceso."
  keywords={["cementerio", "cementerio panama", "cementerio de panama"]}
  canonical="https://www.colinasdelapaz.com/"
>
  <main class="w-full">
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Hero />
      <Description />
      <Services />
      <CTA />
    </div>
  </main>
</Layout>